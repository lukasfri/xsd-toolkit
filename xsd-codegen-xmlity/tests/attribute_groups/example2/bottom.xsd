<?xml version="1.0" encoding="UTF-8"?>
<xs:schema
    xmlns:xs="http://www.w3.org/2001/XMLSchema"
>
    <xs:attributeGroup name="bottomattrgroup">
        <xs:attribute name="tabindex" type="xs:integer" />
    </xs:attributeGroup>
    <xs:group name="bottomgroup">
        <xs:sequence>
            <xs:element name="test" type="xs:string" minOccurs="0" maxOccurs="unbounded" />
        </xs:sequence>
    </xs:group>
    <xs:complexType name="bottomtype" mixed="true">
        <xs:group ref="bottomgroup" />
        <xs:attributeGroup ref="bottomattrgroup" />
    </xs:complexType>
</xs:schema>